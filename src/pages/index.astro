---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../config';
import { getSubstackPosts } from '../substack';

// Combine local posts with Substack posts (which link out to Substack), sorted by date.
const localPosts = (await Astro.glob('./blog/*.{md,mdx}')).map((post) => ({
	title: post.frontmatter.title,
	url: post.url,
	pubDate: post.frontmatter.pubDate,
	external: false,
}));
const substackPosts = (await getSubstackPosts()).map((post) => ({ ...post, external: true }));
const posts = [...localPosts, ...substackPosts].sort(
	(a, b) => new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf()
);
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			ul {
				list-style-type: none;
				padding: unset;
			}
			ul li {
				display: flex;
			}
			ul li[hidden] {
				display: none;
			}
			.filters {
				display: flex;
				gap: 1rem;
				margin-bottom: 1rem;
			}
			.filters button {
				padding: 0;
				border: none;
				background: none;
				font-family: inherit;
				font-size: 0.9em;
				color: #a0a0a0;
				cursor: pointer;
			}
			.filters button:hover,
			.filters button[aria-pressed='true'] {
				color: #d97706;
			}
			ul li time {
				flex: 0 0 130px;
				font-style: italic;
				color: #595959;
			}
			ul li a:visited {
				color: #8e32dc;
			}
			.external {
				margin-left: 0.5em;
				font-size: 0.75em;
				color: #a0a0a0;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<div class="filters">
					<button type="button" data-filter="all" aria-pressed="true">All</button>
					<button type="button" data-filter="blog" aria-pressed="false">Blog</button>
					<button type="button" data-filter="substack" aria-pressed="false">Substack</button>
				</div>
				<ul>
					{
						posts.map((post) => (
							<li data-source={post.external ? 'substack' : 'blog'}>
								<time datetime={post.pubDate}>
									{new Date(post.pubDate).toLocaleDateString('en-us', {
										year: 'numeric',
										month: 'short',
										day: 'numeric',
									})}
								</time>
								{post.external ? (
									<a href={post.url} target="_blank" rel="noopener">
										{post.title}
										<span class="external">Substack</span>
									</a>
								) : (
									<a href={post.url}>{post.title}</a>
								)}
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
		<script>
			const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
			const items = document.querySelectorAll<HTMLLIElement>('li[data-source]');

			buttons.forEach((button) => {
				button.addEventListener('click', () => {
					const filter = button.dataset.filter;
					buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
					items.forEach((item) => {
						item.hidden = filter !== 'all' && item.dataset.source !== filter;
					});
				});
			});
		</script>
	</body>
</html>
