---
import { SUBSTACK_URL } from '../substack';
---

<section class="newsletter">
	<iframe
		src={`${SUBSTACK_URL}/embed`}
		title="Subscribe on Substack"
		width="100%"
		height="320"
		frameborder="0"
		scrolling="no"
		loading="lazy"></iframe>
</section>

<style>
	.newsletter {
		margin-top: 3rem;
	}

	.newsletter iframe {
		display: block;
		border: 1px solid rgba(217, 119, 6, 0.3);
		border-radius: 8px;
		background: #fff;
	}
</style>
